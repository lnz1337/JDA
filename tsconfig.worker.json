{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/vitest-plugin/types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/worker/**/*",
    "src/shared/**/*",
    "test/**/*",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "test/node/**/*"
  ]
}
