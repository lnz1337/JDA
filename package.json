{
  "name": "jda-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "cross-env CLOUDFLARE_ENV=staging vite build",
    "build:production": "cross-env CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "seed:build": "node scripts/seed-sql.ts",
    "seed:local": "npm run seed:build && wrangler d1 execute DB --local --file=seed/seed.sql",
    "seed:staging": "npm run seed:build && wrangler d1 execute DB --env staging --remote --file=seed/seed.sql",
    "media:upload:staging": "node scripts/upload-media.ts jda-pwa-media-staging",
    "payt:last:staging": "node scripts/payt-last.ts staging 5",
    "payt:reprocess:staging": "node scripts/payt-reprocess.ts",
    "grant:staging": "node scripts/grant.ts",
    "import:compradores": "node scripts/import-compradores.ts",
    "campanha:anuncio": "node scripts/campanha-anuncio.ts",
    "exportar:sem-email": "node scripts/exportar-sem-email.ts",
    "cf-typegen": "wrangler types",
    "icons": "node scripts/make-icons.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.3"
  }
}
